# Облачные модели (шлюз в формате OpenAI).
# Скопируйте этот файл в .env и впишите свой ключ — файл .env в git не попадает
# (он в .gitignore), поэтому ключ уедет только к вам, а не в репозиторий.

# Ключ шлюза. Обязателен: без него облачные участники спектакля не заговорят.
CLOUD_API_KEY=

# Адрес шлюза. По умолчанию — proxyapi.ru, и менять его нужно редко:
# CLOUD_BASE_URL=https://api.proxyapi.ru/v1

# Шлюз сам по себе прокси до OpenAI и остальных моделей, поэтому локальный
# прокси проекта на эти запросы не вешается — делать ничего не надо.