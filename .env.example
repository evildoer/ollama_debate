# Облачные модели (шлюз в формате OpenAI).
# Скопируйте этот файл в .env и впишите свой ключ — файл .env в git не попадает
# (он в .gitignore), поэтому ключ уедет только к вам, а не в репозиторий.

# Ключ шлюза. Обязателен: без него облачные участники спектакля не заговорят.
CLOUD_API_KEY=

# Адрес шлюза. По умолчанию — proxyapi.ru, и менять его нужно редко:
# CLOUD_BASE_URL=https://api.proxyapi.ru/v1

# Шлюз сам по себе прокси до OpenAI и остальных моделей, поэтому локальный
# прокси проекта на эти запросы не вешается — делать ничего не надо.

# ---------------------------------------------------------------------------
# Что уходит в запросе к шлюзу
# ---------------------------------------------------------------------------
# Сначала облачный участник просто говорит: в теле запроса только модель,
# сообщения и stream. Всё остальное выключено и включается по одному, когда
# простой разговор уже получился. Причина не в осторожности: каждый лишний
# ключ в теле — повод для «400 Bad Request», а двадцать таких ответов за минуту
# переводят ключ в паузу, и дальше шлюз отвечает 429 на всё подряд.
#
# Числа характеров участника (temperature, top_p, seed и прочие).
# Включить: CLOUD_SEND_PARAMS=1
#
# Инструмент поиска в интернете. У облачных моделей он свой, и не всякая
# модель понимает нашу схему инструмента.
# Включить: CLOUD_SEND_TOOLS=1
#
# Поле «name» у сообщений. Схема OpenAI разрешает в нём только латиницу, цифры,
# дефис и подчёркивание, а у нас там русские имена — это и есть главная причина
# «400 Bad Request». Имя говорящего и так видно из текста сообщения.
# Включить: CLOUD_SEND_MESSAGE_NAMES=1

# ---------------------------------------------------------------------------
# Ошибка 429 «Too many requests»
# ---------------------------------------------------------------------------
# Это просьба сбавить темп, а не поломка: приложение само повторяет запрос
# с растущей задержкой (1, 2, 4 секунды) и говорит об этом в консоли.
# Свои задержки: CLOUD_RETRY_DELAYS=(1, 2, 4)
