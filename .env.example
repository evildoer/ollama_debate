# ОБЛАЧНЫЕ МОДЕЛИ: КЛЮЧ И АДРЕС ШЛЮЗА
#
# Скопируйте этот файл в .env и впишите свой ключ. Файл .env в git не попадает
# (он в .gitignore), поэтому ключ уедет только к вам, а не в репозиторий.
#
# Здесь живут ровно две вещи — данные вашего облачного сервиса. Всё остальное
# про облако (числа характера, поиск, окно истории сцены, сроки) настраивается
# в файле aitheatre/settings.py: там его видно и можно объяснить словами.
# Всё, что написано здесь помимо этих двух строк, приложение не читает — оно
# говорит об этом при запуске и подсказывает, куда строку перенести.

# Ключ шлюза. Обязателен: без него облачные участники спектакля не заговорят.
CLOUD_API_KEY=

# Адрес шлюза (без слэша на конце). Значение по умолчанию — proxyapi.ru;
# строку можно убрать вовсе, тогда возьмётся адрес из settings.py.
# Шлюз сам по себе прокси до OpenAI и остальных моделей, поэтому локальный прокси
# проекта на эти запросы не вешается — делать ничего не надо.
CLOUD_BASE_URL=https://api.proxyapi.ru/v1
