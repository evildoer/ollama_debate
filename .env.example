[TEMPLATE]
# Облачные модели (шлюз в формате OpenAI).
# Скопируйте этот файл в .env и впишите свой ключ — файл .env в git не попадает
# (он в .gitignore), поэтому ключ уедет только к вам, а не в репозиторий.
#
# Все настройки написаны настоящими строками «ИМЯ=ЗНАЧЕНИЕ»: их можно менять
# прямо здесь, ничего не раскомментируя. Строки, начинающиеся с решётки, —
# это подсказки, а не настройки.

# Ключ шлюза. Обязателен: без него облачные участники спектакля не заговорят.
CLOUD_API_KEY=

# Адрес шлюза (без слэша на конце) и сколько секунд ждать ответа.
# Второе стоит поднимать для больших «думающих» моделей: они отвечают дольше,
# а не дождавшись, приложение показывает ошибку и запрос придётся повторять.
CLOUD_BASE_URL=https://api.proxyapi.ru/v1
CLOUD_TIMEOUT=180

# Шлюз сам по себе прокси до OpenAI и остальных моделей, поэтому локальный
# прокси проекта на эти запросы не вешается — делать ничего не надо.

# ---------------------------------------------------------------------------
# Что уходит в запросе к шлюзу: 0 — выключено, 1 — включено
# ---------------------------------------------------------------------------
# Сначала облачный участник просто говорит: в теле запроса только модель,
# сообщения и stream. Остальное включается по одному, когда простой разговор
# уже получился. Причина не в осторожности: каждый лишний ключ в теле — повод
# для «400 Bad Request», а двадцать таких ответов за минуту переводят ключ
# в паузу, и дальше шлюз отвечает 429 на всё подряд.

# Числа характера участника. Совсем безопасны temperature, top_p и max_tokens;
# seed, presence_penalty и frequency_penalty понимают не все вендоры, и именно
# их шлюз может не принять.
CLOUD_SEND_PARAMS=0

# Инструмент поиска в интернете. Если модель его не принимает, приложение
# заметит это само и дальше будет говорить с ней без поиска.
CLOUD_SEND_TOOLS=0

# Поле «name» у сообщений. Схема OpenAI разрешает в нём только латиницу, цифры,
# дефис и подчёркивание, а у нас там русские имена — это и есть главная причина
# «400 Bad Request». Имя говорящего и так видно из текста сообщения.
CLOUD_SEND_MESSAGE_NAMES=0

# Ответ приходит по частям, и лента печатает его на глазах — как у живого
# человека, а не одним куском в конце. 0 — ждать ответ целиком, как раньше.
CLOUD_STREAM=1

# min_p, top_k и repeat_penalty в схему OpenAI не входят, но их понимают движки
# вроде vLLM и SGLang, на которых стоят шлюзы. Включите, если ваш шлюз их
# принимает: без них характеры на min_p («Циркуль», «Импровизатор») на облаке
# будут вести себя как обычная модель.
CLOUD_PASS_OLLAMA_EXTRAS=0

# ---------------------------------------------------------------------------
# Ошибка 429 «Too many requests»
# ---------------------------------------------------------------------------
# Это просьба сбавить темп, а не поломка: приложение само повторяет запрос
# с растущей задержкой и говорит об этом в консоли.
CLOUD_RETRY_DELAYS=1, 2, 4
